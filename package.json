{
  "name": "nuxt-style-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "fix:escapes": "node scripts/fix-escaped-backticks.cjs src/data --write",
    "check:fences": "node scripts/check-code-fences.cjs",
    "test:render": "node scripts/test-renderer.cjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "element-plus": "^2.9.0",
    "dagre": "^0.8.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "@types/dagre": "^0.7.52"
  }
}